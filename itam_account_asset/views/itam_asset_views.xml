<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_itam_asset_form_account" model="ir.ui.view">
        <field name="name">itam.asset.form.account.asset</field>
        <field name="model">itam.asset</field>
        <field name="inherit_id" ref="it_asset_management.view_itam_asset_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_create_account_asset" type="object" class="oe_stat_button"
                        icon="fa-money" groups="account.group_account_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text" invisible="account_asset_id">Create Depreciation</span>
                        <span class="o_stat_text" invisible="not account_asset_id">Depreciation</span>
                        <field name="account_asset_state" widget="badge" invisible="not account_asset_id"/>
                    </div>
                </button>
            </div>
            <field name="po_ref" position="after">
                <field name="account_asset_id" readonly="1"/>
                <field name="account_asset_book_value" invisible="not account_asset_id"/>
            </field>
        </field>
    </record>

</odoo>
