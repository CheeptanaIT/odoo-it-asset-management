<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_itam_assign_wizard_form" model="ir.ui.view">
        <field name="name">itam.assign.wizard.form</field>
        <field name="model">itam.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign / Return Asset">
                <group>
                    <field name="mode" invisible="1"/>
                    <field name="asset_id"/>
                    <field name="employee_id" invisible="mode != 'assign'"
                           required="mode == 'assign'"/>
                    <field name="location_id"/>
                    <field name="date"/>
                    <field name="condition"
                           string="Condition Out" invisible="mode != 'assign'"/>
                    <field name="condition"
                           string="Condition In" invisible="mode != 'return'"/>
                    <field name="print_form"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
