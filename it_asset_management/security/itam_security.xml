<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_itam" model="ir.module.category">
        <field name="name">IT Asset Management</field>
        <field name="description">Manage IT hardware, assignments, licenses and repairs.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_itam_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_itam"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_itam_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_itam"/>
        <field name="implied_ids" eval="[(4, ref('group_itam_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="itam_asset_company_rule" model="ir.rule">
        <field name="name">IT Asset: multi-company</field>
        <field name="model_id" ref="model_itam_asset"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itam_license_company_rule" model="ir.rule">
        <field name="name">Software License: multi-company</field>
        <field name="model_id" ref="model_itam_software_license"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itam_maintenance_company_rule" model="ir.rule">
        <field name="name">Maintenance Log: multi-company</field>
        <field name="model_id" ref="model_itam_maintenance_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="itam_location_company_rule" model="ir.rule">
        <field name="name">IT Asset Location: multi-company</field>
        <field name="model_id" ref="model_itam_location"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
