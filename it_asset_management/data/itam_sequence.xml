<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_itam_asset" model="ir.sequence">
        <field name="name">IT Asset Tag</field>
        <field name="code">itam.asset</field>
        <field name="prefix">ITAM/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_itam_maintenance_log" model="ir.sequence">
        <field name="name">IT Asset Maintenance Log</field>
        <field name="code">itam.maintenance.log</field>
        <field name="prefix">ITAM/MNT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
