<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_itam_handover" model="report.paperformat">
        <field name="name">ITAM Handover A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_itam_handover" model="ir.actions.report">
        <field name="name">Asset Handover Form</field>
        <field name="model">itam.asset.assignment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_asset_management.report_itam_handover</field>
        <field name="report_file">it_asset_management.report_itam_handover</field>
        <field name="paperformat_id" ref="paperformat_itam_handover"/>
        <field name="binding_model_id" ref="model_itam_asset_assignment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
