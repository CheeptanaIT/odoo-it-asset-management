<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LIST ============ -->
    <record id="view_itam_asset_tree" model="ir.ui.view">
        <field name="name">itam.asset.tree</field>
        <field name="model">itam.asset</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('retired','disposed','lost')"
                  decoration-warning="warranty_state == 'expiring'"
                  decoration-danger="warranty_state == 'expired'">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_no" optional="show"/>
                <field name="assigned_employee_id"/>
                <field name="location_id" optional="show"/>
                <field name="warranty_end" optional="show"/>
                <field name="warranty_state" optional="hide"/>
                <field name="purchase_price" optional="hide" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'in_repair'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ KANBAN ============ -->
    <record id="view_itam_asset_kanban" model="ir.ui.view">
        <field name="name">itam.asset.kanban</field>
        <field name="model">itam.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="warranty_state"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex align-items-center me-2">
                            <field name="image_128" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main class="d-flex flex-column">
                            <field name="name" class="fw-bold fs-5"/>
                            <span class="text-muted">
                                <field name="asset_tag"/> · <field name="category_id"/>
                            </span>
                            <field name="assigned_employee_id" widget="many2one_avatar_employee"
                                   class="pt-1" t-if="record.assigned_employee_id.raw_value"/>
                            <footer class="pt-1">
                                <field name="state" widget="badge"
                                       decoration-success="state == 'available'"
                                       decoration-info="state == 'assigned'"
                                       decoration-warning="state == 'in_repair'"
                                       decoration-danger="state == 'lost'"/>
                                <field name="warranty_state" widget="badge" class="ms-1"
                                       decoration-success="warranty_state == 'valid'"
                                       decoration-warning="warranty_state == 'expiring'"
                                       decoration-danger="warranty_state == 'expired'"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="view_itam_asset_form" model="ir.ui.view">
        <field name="name">itam.asset.form</field>
        <field name="model">itam.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_assign_wizard" type="object" string="Assign"
                            class="btn-primary" invisible="state not in ('draft','available')"/>
                    <button name="action_open_return_wizard" type="object" string="Return"
                            class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_set_available" type="object" string="Set Available"
                            invisible="state not in ('draft','in_repair')"/>
                    <button name="action_send_to_repair" type="object" string="Send to Repair"
                            invisible="state not in ('available','assigned')"/>
                    <button name="action_return_from_repair" type="object" string="Back from Repair"
                            invisible="state != 'in_repair'"/>
                    <button name="action_retire" type="object" string="Retire"
                            groups="it_asset_management.group_itam_manager"
                            confirm="Retire this asset? It will be archived."
                            invisible="state in ('retired','disposed','lost')"/>
                    <button name="action_dispose" type="object" string="Dispose"
                            groups="it_asset_management.group_itam_manager"
                            confirm="Mark this asset as disposed? It will be archived."
                            invisible="state in ('disposed','lost')"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost"
                            groups="it_asset_management.group_itam_manager"
                            confirm="Mark this asset as lost? It will be archived."
                            invisible="state in ('retired','disposed','lost')"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            groups="it_asset_management.group_itam_manager"
                            invisible="active or state not in ('retired','disposed','lost')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,available,assigned,in_repair"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Repairs"/>
                        </button>
                        <button name="action_view_software" type="object" class="oe_stat_button" icon="fa-th">
                            <field name="software_count" widget="statinfo" string="Software"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dell Latitude 5440"/></h1>
                        <h2><field name="asset_tag" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="manufacturer"/>
                            <field name="model_number"/>
                            <field name="serial_no"/>
                            <field name="barcode"/>
                        </group>
                        <group>
                            <field name="assigned_employee_id" readonly="1"/>
                            <field name="assigned_department_id" readonly="1"/>
                            <field name="location_id"/>
                            <field name="assigned_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hardware" name="hardware">
                            <group>
                                <group>
                                    <field name="cpu"/>
                                    <field name="ram_gb"/>
                                    <field name="storage"/>
                                    <field name="operating_system"/>
                                </group>
                                <group>
                                    <field name="hostname"/>
                                    <field name="ip_address"/>
                                    <field name="mac_address"/>
                                </group>
                            </group>
                        </page>
                        <page string="Purchase &amp; Warranty" name="purchase">
                            <group>
                                <group string="Purchase">
                                    <field name="purchase_date"/>
                                    <field name="purchase_price"/>
                                    <field name="vendor_id"/>
                                    <field name="invoice_ref"/>
                                    <field name="po_ref"/>
                                </group>
                                <group string="Warranty">
                                    <field name="warranty_start"/>
                                    <field name="warranty_end"/>
                                    <field name="warranty_provider"/>
                                    <field name="warranty_state"/>
                                </group>
                            </group>
                        </page>
                        <page string="Assignment History" name="assignments">
                            <field name="assignment_ids" readonly="1">
                                <list decoration-info="is_open == True">
                                    <field name="date_out"/>
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="location_id"/>
                                    <field name="condition_out"/>
                                    <field name="date_in"/>
                                    <field name="condition_in"/>
                                    <field name="is_open" string="Open"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintenance" name="maintenance">
                            <field name="maintenance_log_ids" context="{'default_asset_id': id}">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="request_date"/>
                                    <field name="maintenance_type"/>
                                    <field name="under_warranty"/>
                                    <field name="cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Software" name="software">
                            <field name="software_install_ids" context="{'default_asset_id': id}">
                                <list editable="bottom">
                                    <field name="license_id"/>
                                    <field name="software_id"/>
                                    <field name="install_date"/>
                                    <field name="uninstall_date"/>
                                    <field name="is_active" string="Active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="view_itam_asset_search" model="ir.ui.view">
        <field name="name">itam.asset.search</field>
        <field name="model">itam.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Asset"
                       filter_domain="['|','|',('name','ilike',self),('asset_tag','ilike',self),('serial_no','ilike',self)]"/>
                <field name="category_id"/>
                <field name="assigned_employee_id"/>
                <field name="location_id"/>
                <field name="vendor_id"/>
                <separator/>
                <filter name="f_available" string="Available" domain="[('state','=','available')]"/>
                <filter name="f_assigned" string="Assigned" domain="[('state','=','assigned')]"/>
                <filter name="f_in_repair" string="In Repair" domain="[('state','=','in_repair')]"/>
                <filter name="f_active_lifecycle" string="In Service"
                        domain="[('state','in',('draft','available','assigned','in_repair'))]"/>
                <separator/>
                <filter name="f_warranty_expiring" string="Warranty Expiring" domain="[('warranty_state','=','expiring')]"/>
                <filter name="f_warranty_expired" string="Warranty Expired" domain="[('warranty_state','=','expired')]"/>
                <separator/>
                <filter name="f_archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="g_employee" string="Assigned To" context="{'group_by': 'assigned_employee_id'}"/>
                    <filter name="g_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="g_warranty" string="Warranty" context="{'group_by': 'warranty_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ PIVOT / GRAPH ============ -->
    <record id="view_itam_asset_pivot" model="ir.ui.view">
        <field name="name">itam.asset.pivot</field>
        <field name="model">itam.asset</field>
        <field name="arch" type="xml">
            <pivot string="Assets">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="purchase_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_itam_asset_graph" model="ir.ui.view">
        <field name="name">itam.asset.graph</field>
        <field name="model">itam.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets" type="bar">
                <field name="category_id"/>
                <field name="purchase_price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============ ACTIONS ============ -->
    <record id="action_itam_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">itam.asset</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_itam_asset_search"/>
        <field name="context">{'search_default_f_active_lifecycle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first IT asset</p>
            <p>Track laptops, desktops, phones and other hardware, assign them to employees and follow their warranty.</p>
        </field>
    </record>

    <record id="action_itam_asset_analysis" model="ir.actions.act_window">
        <field name="name">Asset Analysis</field>
        <field name="res_model">itam.asset</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{}</field>
    </record>

</odoo>
