<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_itam_maintenance_log_tree" model="ir.ui.view">
        <field name="name">itam.maintenance.log.tree</field>
        <field name="model">itam.maintenance.log</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="maintenance_type"/>
                <field name="request_date"/>
                <field name="date_done"/>
                <field name="under_warranty"/>
                <field name="cost" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_itam_maintenance_log_form" model="ir.ui.view">
        <field name="name">itam.maintenance.log.form</field>
        <field name="model">itam.maintenance.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary"
                            invisible="state not in ('new','in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset" type="object" string="Reset to New"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="maintenance_type"/>
                            <field name="request_date"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_done" readonly="1"/>
                        </group>
                        <group>
                            <field name="handled_by" widget="radio"/>
                            <field name="technician_id" invisible="handled_by != 'internal'"/>
                            <field name="vendor_id" invisible="handled_by != 'vendor'"/>
                            <field name="under_warranty"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problem" name="problem">
                            <field name="description" placeholder="Describe the issue..."/>
                        </page>
                        <page string="Resolution" name="resolution">
                            <field name="resolution" placeholder="What was done..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_itam_maintenance_log_calendar" model="ir.ui.view">
        <field name="name">itam.maintenance.log.calendar</field>
        <field name="model">itam.maintenance.log</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance" date_start="request_date" color="maintenance_type" mode="month">
                <field name="asset_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_itam_maintenance_log_graph" model="ir.ui.view">
        <field name="name">itam.maintenance.log.graph</field>
        <field name="model">itam.maintenance.log</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Cost" type="bar">
                <field name="maintenance_type"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_itam_maintenance_log_search" model="ir.ui.view">
        <field name="name">itam.maintenance.log.search</field>
        <field name="model">itam.maintenance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="technician_id"/>
                <filter name="f_open" string="Open" domain="[('state','in',('new','in_progress'))]"/>
                <filter name="f_done" string="Done" domain="[('state','=','done')]"/>
                <filter name="f_warranty" string="Under Warranty" domain="[('under_warranty','=',True)]"/>
                <separator/>
                <filter name="f_my" string="My Jobs" domain="[('technician_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_month" string="Request Month" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_itam_maintenance_log" model="ir.actions.act_window">
        <field name="name">Maintenance Logs</field>
        <field name="res_model">itam.maintenance.log</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="search_view_id" ref="view_itam_maintenance_log_search"/>
    </record>

    <record id="action_itam_maintenance_cost" model="ir.actions.act_window">
        <field name="name">Maintenance Cost</field>
        <field name="res_model">itam.maintenance.log</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

</odoo>
