<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_itam" model="ir.ui.view">
        <field name="name">hr.employee.form.itam</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_itam_assets" type="object" class="oe_stat_button"
                        icon="fa-laptop" groups="it_asset_management.group_itam_user">
                    <field name="itam_asset_count" widget="statinfo" string="IT Assets"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
