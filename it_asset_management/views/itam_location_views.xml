<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_itam_location_tree" model="ir.ui.view">
        <field name="name">itam.location.tree</field>
        <field name="model">itam.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" string="Location"/>
                <field name="asset_count" string="# Assets"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_itam_location_form" model="ir.ui.view">
        <field name="name">itam.location.form</field>
        <field name="model">itam.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_itam_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">itam.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
